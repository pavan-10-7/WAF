cat > .gitignore <<'EOF'
# Python virtual environments
.venv/
venv/
env/
**/.venv/
**/venv/

# Python cache
__pycache__/
*.py[cod]

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Environment variables and secrets
.env
.env.*
!.env.example

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Generated logs
*.log
EOF